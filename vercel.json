{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api?__path=$1" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{server,data,engine,intelligence,contracts,node_modules/@zoowork-ai}/**"
    }
  }
}
