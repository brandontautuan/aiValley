# Server-only settings. Copy to .env (never commit it).
PORT=3000
# Each local instance keeps its own runtime store; this directory is gitignored.
DATA_DIR=.data
# Optional stretch integrations. Leave blank to use deterministic fixtures/templates.
TAVILY_API_KEY=
# Optional ZooWork agents. Leave blank to use deterministic templates/workflows.
# One agent may plan long-horizon strategy; a separate content agent is preferred
# for structured Instagram drafts/explanations. When blank, the strategy agent is used.
ZOOWORK_API_KEY=
ZOOWORK_AGENT_ID=
ZOOWORK_CONTENT_AGENT_ID=
