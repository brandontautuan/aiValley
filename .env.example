# Server-only settings. Copy to .env (never commit it).
PORT=3000
# Each local instance keeps its own runtime store; this directory is gitignored.
DATA_DIR=.data
# Optional stretch integrations. Leave blank to use deterministic fixtures/templates.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
# Optional server-only Growth Planner integration. Leave both blank for the
# deterministic manager-reviewable fallback.
ZOOWORK_GROWTH_PLANNER_URL=
ZOOWORK_API_KEY=
